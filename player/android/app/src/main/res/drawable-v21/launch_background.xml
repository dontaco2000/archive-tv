<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the README banner (TV + ARCHIVE TV + tagline), full-bleed 16:9, shown until Flutter draws its first frame -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
    <item>
        <bitmap android:gravity="fill" android:src="@drawable/launch_splash" />
    </item>
</layer-list>
